{
  "name": "businessmap-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "鎬濆緞 Sijing - An open-source desktop workspace for code-derived business knowledge",
  "author": "Sijing contributors",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "backend:build": "node scripts/build-backend.mjs",
    "package": "npm run build && npm run backend:build && electron-builder --publish never",
    "package:dir": "npm run build && npm run backend:build && electron-builder --dir --publish never",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "test:packaged:all": "node scripts/smoke-packaged.mjs --all",
    "test:platform": "node --test scripts/test-desktop-platforms.mjs",
    "test:backend": "node scripts/test-backend.mjs"
  },
  "build": {
    "appId": "io.businessmap.desktop",
    "productName": "Sijing",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "build-resources/icon.png",
      "build-resources/icon.ico"
    ],
    "extraResources": [
      {
        "from": "build/backend/businessmap-service",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": true,
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "artifactName": "Sijing-${version}-win-${arch}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Sijing-${version}-win-${arch}-portable.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "icon": "build-resources/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Sijing contributors",
      "executableName": "sijing",
      "icon": "build-resources/icon.png"
    },
    "artifactName": "Sijing-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "cytoscape": "^3.34.3",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cytoscape": "^3.21.9",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "type": "module"
}
